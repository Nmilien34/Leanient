# Runtime
NODE_ENV=development
PORT=8080

# MongoDB connection string from MongoDB Atlas or a local Mongo instance.
MONGODB_URI=mongodb://127.0.0.1:27017/leanient

# Session JWT. Generate a random value with at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30d

# Google Cloud Console OAuth 2.0 web client ID.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Apple Developer Sign in with Apple identifiers and key.
APPLE_CLIENT_ID=com.boltzman.leanient
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID

# PEM private key. Use either APPLE_PRIVATE_KEY with escaped newlines or APPLE_PRIVATE_KEY_BASE64.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_PRIVATE_KEY_BASE64=

# Frontend origin allowed by CORS.
FRONTEND_ORIGIN=http://localhost:8081

# AWS S3 progress photo storage. Required in production.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=leanient-progress-photos
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# OpenAI API key for stored verdict explanations. If unset, deterministic verdicts still persist.
OPENAI_API_KEY=your_openai_api_key

# RevenueCat webhook bearer token. Required in production.
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# Cron schedule for missed weekly check-in verdicts. Default is Monday 8 AM in SCHEDULER_TIMEZONE.
SCHEDULER_TIMEZONE=America/New_York
WEEKLY_VERDICT_CRON=0 8 * * 1
