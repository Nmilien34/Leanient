# Public API base URL used by the Expo app.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Alias for Vercel or web tooling that expects NEXT_PUBLIC_* names.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# RevenueCat public SDK keys. Required for native purchase and restore flows.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
