{
  "expo": {
    "name": "Leanient",
    "slug": "leanient",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boltzman.leanient",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.boltzman.leanient"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Leanient uses your camera to scan meals and estimate protein."
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
