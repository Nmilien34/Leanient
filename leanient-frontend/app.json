{
  "expo": {
    "name": "Leanient",
    "slug": "leanient",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.boltzman.leanient",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.boltzman.leanient"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Leanient uses your camera to scan meals and estimate protein."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.853468832171-aampugttrjlj02a9srkinrt5a5hpdqd6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Leanient uses your photos so you can set a profile picture.",
          "cameraPermission": "Leanient uses your camera so you can take a profile picture."
        }
      ],
      "expo-notifications"
    ]
  }
}
