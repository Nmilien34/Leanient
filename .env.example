# Root template. Copy leanient-backend/.env.example into leanient-backend/.env for local API work.

NODE_ENV=development
PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/leanient
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30d
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=ai.boltzman.leanient
APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FRONTEND_ORIGIN=http://localhost:8081

# S3 progress photo storage. Required in production.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=leanient-progress-photos
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# OpenAI API key for stored verdict explanations. If unset, deterministic verdicts still persist.
OPENAI_API_KEY=your_openai_api_key

# RevenueCat webhook verification. Required in production.
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret
APPLE_APP_SPECIFIC_SHARED_SECRET=your_app_specific_shared_secret

# Weekly missed-check-in verdict job. Runs Monday morning by default.
SCHEDULER_TIMEZONE=America/New_York
WEEKLY_VERDICT_CRON=0 8 * * 1

# Frontend
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
EXPO_PUBLIC_APPSFLYER_DEV_KEY=
EXPO_PUBLIC_APPSFLYER_APP_ID=
